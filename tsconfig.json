{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "noUnusedLocals": true,
    "paths": {
      "@courses": [
        "./src/config/courses.json"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
