{
  "name": "skills-mapping",
  "version": "0.4.0",
  "description": "",
  "scripts": {
    "gen:units": "node scripts/gen-units.mjs",
    "gen:courses": "node scripts/gen-courses.mjs",
    "dev": "vite",
    "build": "tsc && vite build && node scripts/postbuild.mjs dist/index.html",
    "test": "vitest run",
    "preview": "vite preview",
    "sync:collector": "node scripts/sync-collector.mjs",
    "test:e2e": "npm run build:admin && COURSES_JSON=tests/fixtures/courses.json vite build --outDir dist-e2e-courses --emptyOutDir && node scripts/postbuild.mjs dist-e2e-courses/index.html && vitest run -c vitest.e2e.config.ts",
    "build:admin": "vite build -c vite.admin-web.config.ts",
    "build:admin-demo": "vite build -c vite.admin.config.ts --mode demo"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/rubik": "^5.1.0",
    "html-to-image": "^1.11.11",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  },
  "type": "module",
  "private": true
}
